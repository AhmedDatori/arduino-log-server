# Smart Green House server
NODE_ENV=production
PORT=3000

# PostgreSQL / Supabase.
# Use DATABASE_URL if your host supports one-line database URLs.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# Or use the individual PG* fields instead of DATABASE_URL.
# PGHOST=db.example.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=replace-me

# Supabase usually needs SSL enabled but not strict certificate validation.
DB_SSL_REJECT_UNAUTHORIZED=false

# Gemini AI features. Leave GEMINI_API_KEY empty to disable AI-only endpoints gracefully.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
